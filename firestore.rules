// Deploy: firebase deploy --only firestore:rules
// If your project already has rules in the Firebase console, merge the
// `contactSubmissions` and `internshipApplications` blocks below into those rules
// instead of replacing everything.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public marketing site: anyone may create a contact submission (no auth).
    // Portal: signed-in users may read / update / delete (inbox).
    match /contactSubmissions/{submissionId} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'inquiryType', 'message', 'read'])
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.inquiryType is string
        && request.resource.data.message is string
        && request.resource.data.read == false;

      allow read, update, delete: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }

    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    match /teamInvites/{inviteId} {
      allow read, write: if request.auth != null;
    }

    // Public careers page: anyone may submit an internship application (no auth).
    // Portal: signed-in users may read / update / delete (applicant review).
    match /internshipApplications/{applicationId} {
      allow create: if request.resource.data.keys().hasAll(['role', 'fullName', 'email', 'resumeLink', 'whyPassionate', 'whyPando', 'skillsets', 'read'])
        && request.resource.data.role is string
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.resumeLink is string
        && request.resource.data.whyPassionate is string
        && request.resource.data.whyPando is string
        && request.resource.data.skillsets is string
        && request.resource.data.read == false;

      allow read, update, delete: if request.auth != null;
    }
  }
}
