// Deploy: firebase deploy --only storage
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // News post photos: publicly viewable (they're rendered on the public /news page),
    // only team members can upload. Keep this email list in sync with firestore.rules.
    match /news/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email.lower() in [
          'tnagai@usc.edu',
          'pan.anye@gmail.com',
          'derekhua2007@gmail.com',
          'longseanlee@gmail.com'
        ] &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
